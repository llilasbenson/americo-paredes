            {
              "type": "paragraph",
              "children": [
                {
                  "text": "This interview is conducted in Spanish, in the home of Americo Paredes's brother Lorenzo Paredes. "
                }
              ]
            },
            {
              "type": "paragraph",
              "children": [
                {
                  "text": "Manuel F. Medrano interviews him as they look through family photo albums for photos of Américo. An English translation of the transcript is available, and can be selected under "
                },
                {
                  "underline": true,
                  "text": "Filter -> Annotation Sets."
                }
              ]
            },
